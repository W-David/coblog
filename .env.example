# coblog 后端环境变量示例（占位符，勿填真实密钥后提交）
# 实际运行仍主要读取 config/config.js（该文件已被 gitignore）

NODE_ENV=dev

# MySQL
DB_NAME=coblog
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=36000

# 阿里云 OSS（如使用）
ALI_OSS_ACCESS_KEY_ID=
ALI_OSS_ACCESS_KEY_SECRET=
ALI_OSS_ROLE_ARN=
ALI_OSS_TOKEN_EXPIRE_TIME=3600

# 初始管理员（仅初始化时参考）
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me
